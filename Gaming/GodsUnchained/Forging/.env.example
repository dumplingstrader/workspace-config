# ─────────────────────────────────────────────────────────────────────────────
#  GU Forge Assistant — wallet configuration
#
#  1. Copy this file to ".env"  (same folder as main.py)
#  2. Fill in the two values below with YOUR OWN dedicated forging wallet.
#  3. Never share your .env or commit it anywhere. It is git-ignored by default.
# ─────────────────────────────────────────────────────────────────────────────

# The public address of your forging wallet (lowercase 0x… is fine).
WALLET_ADDRESS=0xyourwalletaddresshere

# The PRIVATE KEY of that same wallet (0x followed by 64 hex chars).
#
# ⚠  HOT-WALLET WARNING
#    This key is stored in plain text on disk and used to sign on-chain GODS
#    payments automatically. Use a DEDICATED wallet that holds ONLY the GODS +
#    gas you intend to spend on forging. Do NOT use your main wallet's key.
#
# Leave PRIVATE_KEY blank to disable API mode and use the launcher flow instead.
PRIVATE_KEY=0xyourprivatekeyhere

# Optional: path to the Gods Unchained launcher .exe (only used by launcher mode).
# Auto-detected for the current user if omitted.
# GU_LAUNCHER_EXE=C:\Path\To\immutable-launcher\Gods Unchained.exe
